# Copy to .env.local for local dev. In Vercel, set these per environment scope
# (Preview = dev Render API URL, Production = prod Render API URL) instead.
#
# The Next.js server proxies /api/* to NEXT_PUBLIC_API_URL; the browser connects
# Socket.IO directly to NEXT_PUBLIC_SOCKET_URL (usually the same host).
#
#   Local:      http://localhost:3001
#   Remote dev: https://<dev-api>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

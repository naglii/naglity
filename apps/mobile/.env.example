# Copy to .env and set the value that matches WHERE you run the app:
#   • Physical phone (Expo Go), same Wi-Fi  → http://<YOUR_PC_LAN_IP>:3001
#   • Android emulator                      → http://10.0.2.2:3001
#   • iOS simulator / Expo web              → http://localhost:3001
#
# After changing .env, restart Expo with a clear cache:  pnpm --filter mobile start -- -c
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001

# Copy to .env and set the value that matches WHERE you run the app.
# These are inlined into the bundle at build time; after editing, restart Expo
# with a clear cache:  pnpm --filter mobile start -- -c
#
# ── LOCAL (phone + PC on the same Wi-Fi) ────────────────────────────────
#   EXPO_PUBLIC_API_URL=http://<YOUR_PC_LAN_IP>:3001     e.g. http://192.168.1.126:3001
#   Android emulator: http://10.0.2.2:3001   ·   iOS sim / Expo web: http://localhost:3001
#
# ── REMOTE DEV (mobile data / any network) ──────────────────────────────
#   EXPO_PUBLIC_API_URL=https://<dev-api>.onrender.com
#   Run Metro reachable from anywhere too:  npx expo start --tunnel -c
#
# ── PRODUCTION (later — placeholder, do not set yet) ─────────────────────
#   EXPO_PUBLIC_API_URL=https://<prod-api-domain>
#
# SOCKET URL is normally the same host as the API.
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SOCKET_URL=http://localhost:3001

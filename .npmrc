# Keep pnpm from self-managing its own version in the lockfile. pnpm 11 otherwise
# writes a second YAML document (packageManagerDependencies) into pnpm-lock.yaml,
# which Vercel's pnpm 10.x cannot parse ("expected a single document … found more")
# — it then ignores the lockfile and re-resolves deps, bypassing our
# pnpm-workspace.yaml overrides (e.g. @types/react) and breaking the web build.
manage-package-manager-versions=false
